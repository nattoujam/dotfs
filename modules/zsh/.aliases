# ==========
# = common =
# ==========
# {{{

alias pbcopy='xsel --clipboard --input'
# alias rm='rm -i'
alias lp='leafpad'
alias ..='cd ..'
alias -g Z='~/.zshrc'
alias -g A="$DOTFS_ROOT/modules/zsh/.aliases"
alias -g P="$DOTFS_ROOT/modules/zsh/.zsh_private"
alias -g DOT="$DOTFS_ROOT"

# -h option
alias df='df -h'

# ls
alias ls='ls --color=auto -h'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -lF'

# git
alias g='git'
alias gst='git status'
alias gsw='git switch'
alias gl='git log'
alias gr='git rebase'
alias gcan='git commit --amend --no-edit'

# docker
alias d='docker'
alias dc='docker-compose'
alias dps='docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'

alias lg='lazygit'
alias ld='lazydocker'

# }}}

# kotlin
alias kotlinjar='kotlinc -include-runtime -d'

# ========
# = typo =
# ========
# {{{

alias c='cd'
alias bim='vim'
alias ivm='vim'

# }}}

# ===========
# = windows =
# ===========
# {{{

# explorer
# open explorer to current directory
# $ exp .
alias exp='explorer.exe'

# }}}

